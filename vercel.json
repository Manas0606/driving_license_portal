{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/fetchUserInfo.js": {
      "maxDuration": 60
    },
    "api/auth/par.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/userprofile",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin"
        }
      ]
    },
    {
      "source": "/userprofile",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin"
        }
      ]
    }
  ]
}
