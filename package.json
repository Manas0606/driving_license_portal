  },
  "dependencies": {
    "@mosip/sign-in-with-esignet": "0.1.1-beta.0",
    "express": "5.1.0",
    "jose": "6.1.0",
    "helmet": "8.1.0",
    "express-rate-limit": "8.1.0"
  },
  "devDependencies": {
    "vite": "7.2.2"
  }
}
