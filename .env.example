PORT=8080
APP_ORIGIN=http://localhost:8080
ESIGNET_SERVICE_URL=https://esignet.mosip-demo.mosip.net/v1/esignet
ESIGNET_TOKEN_ENDPOINT=https://esignet.mosip-demo.mosip.net/v1/esignet/oauth/v2/token
ESIGNET_USERINFO_ENDPOINT=https://esignet.mosip-demo.mosip.net/v1/esignet/oidc/userinfo
ESIGNET_JWKS_URL=https://esignet.mosip-demo.mosip.net/.well-known/jwks.json
ESIGNET_AUD_URL=https://esignet.mosip-demo.mosip.net/v1/esignet/oauth/v2/token
ESIGNET_EXPECTED_ISSUER=https://esignet.mosip-demo.mosip.net
# Set only if the deployment publishes a different, independently verified ID token issuer.
ESIGNET_TOKEN_ISSUER=https://esignet.mosip-demo.mosip.net/v1/esignet
ESIGNET_CLIENT_ID=
ESIGNET_PRIVATE_JWK_FILE=./secrets/client.jwk
# Optional separate encryption key; if omitted JWE is rejected.
ESIGNET_USERINFO_JWK_FILE=
ESIGNET_SCOPE=openid profile
ESIGNET_ACR="mosip:idp:acr:linked-wallet mosip:idp:acr:biometrics mosip:idp:acr:generated-code"
ESIGNET_USE_PAR=false

