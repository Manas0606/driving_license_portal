PORT=8080
APP_ORIGIN=http://localhost:8080
ESIGNET_DISCOVERY_URL=https://esignet.mosip-demo.mosip.net/.well-known/openid-configuration
ESIGNET_EXPECTED_ISSUER=https://esignet.mosip-demo.mosip.net
# Set only if the deployment publishes a different, independently verified ID token issuer.
ESIGNET_TOKEN_ISSUER=
ESIGNET_CLIENT_ID=
ESIGNET_PRIVATE_JWK_FILE=./secrets/client.jwk
# Optional separate encryption key; if omitted JWE is rejected.
ESIGNET_USERINFO_JWK_FILE=
ESIGNET_SCOPE=openid profile
ESIGNET_ACR="mosip:idp:acr:linked-wallet mosip:idp:acr:biometrics mosip:idp:acr:generated-code"
ESIGNET_USE_PAR=false
